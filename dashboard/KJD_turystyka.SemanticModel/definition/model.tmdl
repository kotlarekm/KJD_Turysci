model Model
	culture: pl-PL
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pl-PL
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DANE_Wielkopolska","Gminy_powPoznańkiego","MiejscaNoclegowe"]

annotation PBI_ProTooling = ["DevMode"]

ref table DANE_Wielkopolska
ref table Gminy_powPoznańkiego
ref table DIM_Kategoria
ref table MiejscaNoclegowe

ref cultureInfo pl-PL

