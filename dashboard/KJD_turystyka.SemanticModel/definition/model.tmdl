model Model
	culture: pl-PL
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pl-PL
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Fact_NoclegiWielkopolska","Fact_MiejscaNoclegowe","Dim_Powiat","Dim_Rok"]

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop"]

ref table Fact_NoclegiWielkopolska
ref table DIM_Kategoria
ref table Fact_MiejscaNoclegowe
ref table Dim_Powiat
ref table Dim_Rok

ref cultureInfo pl-PL

