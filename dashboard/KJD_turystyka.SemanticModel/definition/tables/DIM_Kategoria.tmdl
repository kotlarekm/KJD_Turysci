table DIM_Kategoria
	lineageTag: 2ac56227-db5a-42c4-b109-ba1551739c2e

	measure 'Srednia dlugosc noclegu Poznanski' = ```
			
			VAR Turysci =
			    CALCULATE(
			        SUM('Gminy_powPoznańkiego'[Wartosc]),
			        DIM_Kategoria[Kategoria] = "turyści zagraniczni (nierezydenci)"
			    )
			VAR Noclegi =
			    CALCULATE(
			        SUM('Gminy_powPoznańkiego'[Wartosc]),
			        DIM_Kategoria[Kategoria] = "udzielone noclegi turystom zagranicznym (nierezydentom)"
			    )
			RETURN
			    DIVIDE(Noclegi, Turysci)
			
			```
		lineageTag: 762e9a6a-e0cf-4d6c-aa15-ac25603b6500

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Kategoria
		lineageTag: c60aeef2-d3a5-4e42-b73c-bbb4da76d2a5
		summarizeBy: none
		isNameInferred
		sourceColumn: [Kategoria]

		annotation SummarizationSetBy = Automatic

	partition DIM_Kategoria = calculated
		mode: import
		source =
				
				DATATABLE(
				    "Kategoria" , STRING,
				    {
				        { "turyści zagraniczni (nierezydenci)" },
				        { "udzielone noclegi turystom zagranicznym (nierezydentom)" }
				    }
				)

	annotation PBI_Id = 8b7550b505da4235947cd28d75829d90

